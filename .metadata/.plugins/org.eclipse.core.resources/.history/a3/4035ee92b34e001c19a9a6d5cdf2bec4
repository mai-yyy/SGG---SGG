uint16 ABS(int16 a)
{
    if(a<0)
    {
     a=-a;
    }
    return a;

}

int  ercspe()
{
   return  hope_speed_straight-((0-differ)*(0-differ))*(hope_speed_straight-hope_speed)/2031;

}
