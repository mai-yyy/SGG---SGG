void speedUp()
{
   // gpio_set(MOTOR2_DIR, 0) ;     //加速正转
    pwm_duty(MOTOR2_PWM,2400);
}
void speedDown()    
{
   // gpio_set(MOTOR2_DIR, 1) ;      //急减速反转
    pwm_duty(MOTOR2_PWM,2400);
    pwm_duty(MOTOR1_PWM,0);
}
void speedStop()
{
   // gpio_set(MOTOR2_DIR, 0) ;
    pwm_duty(MOTOR2_PWM,0);
    pwm_duty( ATOM1_CH4_P02_4,0);//停车
}

void Dianji_pid_diff(int16 SpeedHope,uint16 MotorSpeed)   //差速控制
{
  nowErr = SpeedHope - MotorSpeed;
  adjust += (int16) (motorKp * (nowErr - lastErr) + motorKi * nowErr+ motorKd * (nowErr + Err_prelast - 2 * lastErr));
  Err_prelast= lastErr;
  lastErr = nowErr;

//if(nowErr>=90)        //bang bang 加速
//{
//    adjust=8000;
//    gpio_set(MOTOR2_DIR, 0) ;     //加速正转
//    pwm_duty(MOTOR2_PWM,adjust);
//}
//else
//{
 if (adjust <= range_pid_ctl_L)
  {
    adjust=-range_pid_ctl_L;
   // gpio_set(MOTOR2_DIR, 0) ;     //加速正转
    pwm_duty(MOTOR2_PWM,adjust);
}
 else if(adjust>= range_pid_ctl_H)
 {
    adjust=range_pid_ctl_H;
    //gpio_set(MOTOR2_DIR, 0) ;     //加速正转
    pwm_duty(MOTOR2_PWM,adjust);
 }
 else
 {
     //gpio_set(MOTOR2_DIR, 0) ;     //加速正转
     pwm_duty(MOTOR2_PWM,adjust);
 }
//}

