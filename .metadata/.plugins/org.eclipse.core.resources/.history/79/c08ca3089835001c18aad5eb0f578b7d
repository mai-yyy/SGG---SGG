void HUdudeal(uint8 th)
{
    int16 i=59;
     int16 count_t=78,count_tl=78,count_tr=78;
     int16 lcount=78;
     float result=20;
     int32 aa=0,zz=0;
     while((i--)>0)
     {
         //aa++;
         //这里逻辑顺序如下，首先从中间列开始向左搜索，没有碰到大于阈值的边界点就赋值白色值，碰到后
         //就直接进入循环把左边所有点赋值，与此同时count_t的值更改直接跳出左边搜线程序，同时
         //重新对count_t赋值，以进入新的右边搜线循环
         //左边
        while((count_t--)>1)
        {
            result=fabs(500.0*(mt9v03x_image[i][count_t]-mt9v03x_image[i][count_t-1])/
                    (mt9v03x_image[i][count_t]+mt9v03x_image[i][count_t-1]));
            image_data[i][count_t]=1;
            if(result>th)
            {
                zz=result;
                count_tl=count_t;
                while((count_t--)>0)
                {
                    image_data[i][count_t]=0;
                }
            }
        }
        count_t=lcount;
        //右边
              while((count_t++)<158)
              {
                  result=fabs((500.0*(mt9v03x_image[i][count_t]-mt9v03x_image[i][count_t-1])/
                          (mt9v03x_image[i][count_t]+mt9v03x_image[i][count_t-1])));
                  image_data[i][count_t]=1;
                  if(result>th)
                  {
                      count_tr=count_t;
                      while((count_t++)<=159)
                      {
                          image_data[i][count_t]=0;
                      }
                  }
              }
              lcount=(int16)((count_tr+count_tl)/2);
              count_t=lcount;

              ips200_showint16(30,9,result);
              mt9v03x_finish_flag = 0;
             // ips200_showint16(30,8,zz);
     }


}

