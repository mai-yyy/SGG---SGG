//8位数据压缩成一位数据
void Compressed_Data(void)
{
    uint8_t H,W;
    uint8_t *P;
    uint8_t *Data_Pixels=Sent_Data->Pixels;
    union//定义一个公用体
    {
        uint8_t  Byte;
        struct Byte8_Struct Byte_Bit;
    } BIT;
    P=Pixels[0];//将指针指向当前需要处理的行(二值化图像地址)
    for(H=0;H<Image_Height;H++)
    {
        for(W=0;W<(Image_Width>>3);W++)
        {
            BIT.Byte_Bit.bit8=*P++;
            BIT.Byte_Bit.bit7=*P++;
            BIT.Byte_Bit.bit6=*P++;
            BIT.Byte_Bit.bit5=*P++;
            BIT.Byte_Bit.bit4=*P++;
            BIT.Byte_Bit.bit3=*P++;
            BIT.Byte_Bit.bit2=*P++;
            BIT.Byte_Bit.bit1=*P++;
            *Data_Pixels++=BIT.Byte;
        }
    }
}
//加载Data
void Set_DataToCon(void)
{
    uint8_t *Data_Con=Sent_Data->Data_Con;

    #if(DataNum>=1)
    {
        *(uint8_t *)Data_Con=DefaultParValue1;
        *(uint8_t *)(Data_Con + 4) = ~*(uint8_t *)(Data_Con);
        *(uint8_t *)(Data_Con + 5) = ~*(uint8_t *)(Data_Con+1);
        *(uint8_t *)(Data_Con + 6) = ~*(uint8_t *)(Data_Con+2);
        *(uint8_t *)(Data_Con + 7) = ~*(uint8_t *)(Data_Con+3);
        Data_Con+=8;
    }
    #endif
    #if(DataNum>=2)
    {
        *(float *)Data_Con=DefaultParValue2;
        *(uint8_t *)(Data_Con + 4) = ~*(uint8_t *)Data_Con;
        Data_Con+=8;
    }
    #endif
    #if(DataNum>=3)
    {
        *(float *)Data_Con=DefaultParValue3;
        *(uint8_t *)(Data_Con + 4) = ~*(uint8_t *)Data_Con;
        Data_Con+=8;
    }
    #endif
    #if(DataNum>=4)
    {
        *(float *)Data_Con=DefaultParValue4;
        *(uint8_t *)(Data_Con + 4) = ~*(uint8_t *)Data_Con;
        Data_Con+=8;
    }
    #endif
}
