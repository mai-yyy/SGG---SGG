
#include "encoder.h"

void encoder_init(void)
{
    gpt12_init(GPT12_T6, Ecoder_Pin1, Ecoder_Pin2);//初始化编码器

    gpt12_init(GPT12_T4, GPT12_T4INA_P02_8, GPT12_T4EUDA_P00_9);//初始化编码器

}

int16 get_speed(void)
 {
    int16 speed=0;
    speed = gpt12_get(GPT12_T6) ;     //采集右边编码器脉冲
    gpt12_clear(GPT12_T6);      //计数器清零

    if(!gpio_get(Ecoder_Pin2))    //判断采集方向
    speed = -speed;
    return speed;
 }


int16 get_speed_L(void)
 {
    int16 speed=0;
    speed = gpt12_get(GPT12_T4) ;     //采集右边编码器脉冲
    gpt12_clear(GPT12_T4);      //计数器清零
    if(!gpio_get(GPT12_T4EUDA_P00_9))    //判断采集方向
    speed = -speed;
    return speed;
 }
