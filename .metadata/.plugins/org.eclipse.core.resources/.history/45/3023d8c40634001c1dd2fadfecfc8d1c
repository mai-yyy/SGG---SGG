void Optimalpoint()
{
   int16  Optimalpoint_row=endline;
   uint8 left_Optimalpoint_get=0;
   uint8 left_Optimalpoint_over=0;
   uint8 right_Optimalpoint_get=158;
   uint8 right_Optimalpoint_over=0;
  for(uint8 i=0;i<158;i++)
  {
      if(image_data[Optimalpoint_row][i]&&image_data[Optimalpoint_row+1][i]&&!left_Optimalpoint_over)//左边
      {
          left_Optimalpoint_get=i;
          right_Optimalpoint_over=0;
          left_Optimalpoint_over=1;
      }
      else if(right_Optimalpoint_over&&left_Optimalpoint_over)
      {break;}
      else if(image_data[Optimalpoint_row][i]&&image_data[Optimalpoint_row+1][i]&&left_Optimalpoint_over&&!image_data[Optimalpoint_row][i+1])
      {
          right_Optimalpoint_get=i;
          right_Optimalpoint_over=1;
      }//右边未丢线situation
      else if(!image_data[Optimalpoint_row][i]&&image_data[Optimalpoint_row][i-1]&&left_Optimalpoint_over)
           {
               right_Optimalpoint_get=i-1;
               right_Optimalpoint_over=1;
           }//左右相同 即只有一个点
      else if(i==157)
          {
              if(image_data[Optimalpoint_row][157]&&image_data[Optimalpoint_row][156]&&image_data[Optimalpoint_row+1][157]&&left_Optimalpoint_over)
              {right_Optimalpoint_get=157;right_Optimalpoint_over=1;}
          }//右边丢线situation

  }
  final_Optimalpoint_get=(left_Optimalpoint_get+right_Optimalpoint_get)>>1;
}

//Maiy_2_dimensional optimal_v20_get(Maiy_characteristic_point *temporarily_char)
void optimal_v20_get(Maiy_characteristic_point *temporarily_char)     //其实无需Maiy_2_dimensional类型的返回值，直接调用real_char即可
{
    Maiy_2_dimensional temp_ReturnPoint = {0, 0};
     int16 Y;
     int16 X;
     Maiy_2_dimensional my_left_to_right = {0, 0}; /*用来临时保存从左往右找的最优点*/
     Maiy_2_dimensional my_right_to_left = {0, 0}; /*用来临时保存从右往左找的最优点*/

     temporarily_char->my_final_tOptimalPoint.my_x=0;
     temporarily_char->my_final_tOptimalPoint.my_y=0;
     temporarily_char->my_left_LOptimalPoint.my_x=0;
     temporarily_char->my_left_LOptimalPoint.my_y=0;
     temporarily_char->my_right_OptimalPoint.my_x=0;
     temporarily_char->my_right_OptimalPoint.my_y=0;
     temporarily_char->m_stCenterLinePoint.my_x = 0; //中线对应的的白行的最大高度  ,没用
     temporarily_char->m_stCenterLinePoint.my_y = 0;
     temporarily_char->m_u32LAllArea = 0;
     temporarily_char->m_u32RAllArea = 0;

     memset(temporarily_char->mylinest, 0, sizeof(temporarily_char->mylinest));

     X = MT9V032_W-2;
     while ((--X) + 1)
     {
         Y = MT9V032_H - 2;
         while (Y > (MT9V032_H / 2) && ((1 == image_data[Y][X]) || (0 == image_data[Y + 1][X])))
         {
             (temporarily_char->mylinest[X])++;
             Y--;
         }
         while (Y && (1 == image_data[Y][X]))
         {
             (temporarily_char->mylinest[X])++;
             Y--;
         }
     }


     X = MT9V032_W - 2;
     while (X--)
     {
         if (temporarily_char->mylinest[X] >= my_right_to_left.my_y)
         {
             my_right_to_left.my_y = temporarily_char->mylinest[X];
             my_right_to_left.my_x=X;
         }
         if (X < MT9V032_W / 2 && temporarily_char->mylinest[X] >= temporarily_char->my_left_LOptimalPoint.my_y)
         {
             temporarily_char->my_left_LOptimalPoint.my_y = temporarily_char->mylinest[X];
             temporarily_char->my_left_LOptimalPoint.my_x = X;
         }
         if (X < MT9V032_W / 2)
             temporarily_char->m_u32LAllArea += temporarily_char->mylinest[X];
     }
     X = 0;
     while ((++X) < MT9V032_W - 2)
     {
         if (temporarily_char->mylinest[X - 1] >= my_left_to_right.my_y)
         {
             my_left_to_right.my_y = temporarily_char->mylinest[X - 1];
             my_left_to_right.my_x = X;
         }
         if (X > MT9V032_W / 2 && temporarily_char->mylinest[X] >= temporarily_char->my_right_OptimalPoint.my_y)
         {
             temporarily_char->my_right_OptimalPoint.my_y = temporarily_char->mylinest[X];
             temporarily_char->my_right_OptimalPoint.my_x = X;
         }
         if (X > MT9V032_W / 2)
             temporarily_char->m_u32RAllArea += temporarily_char->mylinest[X];
     }


     if (my_left_to_right.my_x != 0 && my_right_to_left.my_x != 0)
     {
         temp_ReturnPoint.my_x = (int16)((my_left_to_right.my_x + my_right_to_left.my_x) * 0.5f);
         temp_ReturnPoint.my_y = (int16)(MT9V032_H - temporarily_char->mylinest[temp_ReturnPoint.my_x]);
     }
     if (abs(my_right_to_left.my_x - my_left_to_right.my_x) > MT9V032_H * 2)
     {
         if (temporarily_char->m_u32LAllArea < temporarily_char->m_u32RAllArea)
         {
             temp_ReturnPoint.my_x = (int16)((temp_ReturnPoint.my_x + my_left_to_right.my_x) * 0.5f);
             temp_ReturnPoint.my_y = (int16)(MT9V032_H - temporarily_char->mylinest[temp_ReturnPoint.my_x]);
         }
         if (temporarily_char->m_u32LAllArea > temporarily_char->m_u32RAllArea)
         {
             temp_ReturnPoint.my_x = (int16)((temp_ReturnPoint.my_x + my_right_to_left.my_x) * 0.5f);
             temp_ReturnPoint.my_y = (int16)(MT9V032_H - temporarily_char->mylinest[temp_ReturnPoint.my_x]);
         }
     }
     temporarily_char->my_final_tOptimalPoint = temp_ReturnPoint; //将最优点返回直接赋值到p_stBorder结构体中,实际函数也返回了这个变量,在调用的地方使用函数有一个ST_2D_INT_POINT_INFO类型的变量来接也可以
     temporarily_char->m_stCenterLinePoint.my_x = MT9V032_W >> 1;
     temporarily_char->m_stCenterLinePoint.my_y = MT9V032_H - temporarily_char->mylinest[temporarily_char->m_stCenterLinePoint.my_x];
//     return temp_ReturnPoint; //返回实际计算出的最优点
 }

